# Ignore all bin and obj directories in any subfolder
**/bin/
**/obj/

# Ignore generated files commonly found in obj directory
*.dll
*.exe
*.pdb
*.cache
*.json

# General Node and environment files
**/node_modules/
**/.pnp
.pnp.js
**/dist/
**/.vite/
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files
.env
.env.*
appsettings.local.json
appsettings.*.local.json
